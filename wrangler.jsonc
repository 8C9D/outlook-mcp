{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "outlook-mcp",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  // core/token.ts scopes the Graph token provider with AsyncLocalStorage from
  // node:async_hooks, which nodejs_compat provides on workerd.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Keeps the Graph change-notification subscription alive. Mail subscriptions
  // expire after at most 4230 minutes (~2.9 days) and Graph deletes them
  // silently, so this runs every 6 hours and renews once less than a day is
  // left — many chances to recover before anything lapses.
  "triggers": { "crons": ["17 */6 * * *"] },
  "vars": {
    // Public origin of this Worker. Graph is told to deliver notifications to
    // PUBLIC_BASE_URL + /notifications, so it must match the deployed hostname.
    "PUBLIC_BASE_URL": "https://outlook-mcp.arthur-yuhao-zhang.workers.dev"
  },
  "kv_namespaces": [
    // Microsoft tokens: the rotating refresh token, the cached access token,
    // and short-lived device-code authorization flows.
    { "binding": "OUTLOOK_KV", "id": "a7e71a84c60549e48b32ef0ac7a7569d" },
    // Owned entirely by @cloudflare/workers-oauth-provider: registered clients,
    // grants, authorization codes and tokens. The binding name is fixed.
    { "binding": "OAUTH_KV", "id": "bea2cb89a11f42ce82f0182149828a08" }
  ]
  // Secrets (never committed; set with `npx wrangler secret put <NAME>`):
  //   MS_CLIENT_ID       Application (client) ID of the Entra app registration
  //   ALLOWED_MS_USER_ID Graph /me id of the one account allowed to authorize
  //   ALLOWED_MS_UPN     that account's userPrincipalName / mail
  //
  // ALLOW_DIRECT_AUTHORIZE ("true" enables POST /authorize with a caller-held
  // Microsoft access token) is deliberately NOT set here and NOT a deployed
  // secret: production only authorizes through the interactive device-code
  // flow. Local `wrangler dev` runs enable it via the gitignored .dev.vars.
  // Remote test r5 asserts the deployed Worker refuses the direct path.
}
