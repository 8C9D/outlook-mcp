{
  "name": "outlook-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server connecting Claude to a personal Outlook account via Microsoft Graph (mail search/read/draft, calendar list/create; drafts only, never sends mail).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "verify": "tsx src/verify.ts",
    "login": "tsx src/login.ts",
    "serve": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "test:tools": "tsx src/test-tools.ts"
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
